/* Metadata stub for the assembly kernel hgemm_f16 (generated by gen_hgemm.py): ocloc compiles this, and the build
 * swaps its machine code for the assembly. The signature fixes the payload registers the assembly reads (see the
 * zeinfo); the body only has to keep every argument alive and the buffers stateful (binding-table surfaces).
 * One 16-lane work-group (one hardware thread) per 16 x 32 tile of C; scal[0], scal[1]: the scales the packing applied
 * to a and b (C = alpha / (scal[0] scal[1]) a b). */
#pragma OPENCL EXTENSION cl_khr_fp16 : enable
#pragma OPENCL EXTENSION cl_intel_subgroups : enable
#pragma OPENCL EXTENSION cl_intel_subgroups_short : enable

__attribute__((intel_reqd_sub_group_size(16))) __attribute__((reqd_work_group_size(16, 1, 1)))
kernel void hgemm_f16(global const ushort *a, global const ushort *b, global float *c, global const float *scal,
                      uint m, uint n, uint k, float alpha) {
    const uint panels = n / 32, t = get_group_id(0), row_panel = t / panels, col_panel = t % panels;
    global const ushort *ap = a + row_panel * k * 16;
    global const ushort *bp = b + col_panel * k * 32;
    global float *out = c + row_panel * 16 * n + col_panel * 32;
    const ushort av = intel_sub_group_block_read_us(ap);
    const ushort bv = intel_sub_group_block_read_us(bp);
    const float sc = as_float(intel_sub_group_block_read((global const uint *)scal));
    if (row_panel * 16 < m)
        intel_sub_group_block_write4((global uint *)out, as_uint4((float4)(alpha * sc * (float)(av + bv))));
}
