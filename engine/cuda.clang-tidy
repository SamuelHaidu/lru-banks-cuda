# Device-side lint: the __device__ / __global__ half of every .cu (clang-tidy --cuda-device-only), the kernels.
# The host profile is .clang-tidy. Run by `cmake --build --preset lint --target tidy`.
#
# Kernels are index arithmetic over raw pointers into registers and shared memory, so the guideline checks about
# pointers and arrays are off here. What stays on are the bug classes that bite kernels:
#   bugprone-implicit-widening-of-multiplication-result: `row * stride` computed in 32 bits, then widened: the
#     classic overflow once a tensor passes 2^31 elements.
#   narrowing conversions: a 64-bit offset or size stored in an int.
#   init-variables, pro-type-member-init: registers or struct fields read before they are written.
#   the clang static analyzer: null dereferences, divisions by zero, uninitialized reads, dead stores.
#   misleading indentation, suspicious semicolons / sizeof / memset, signed char misuse, infinite loops, ...
# Off: redundant-declaration (every kernel declares its own `extern __shared__` buffer), no-recursion and padding
# (as in the host profile).
# Barrier divergence, races and out-of-bounds accesses are not visible statically: compute-sanitizer (racecheck,
# synccheck, memcheck, initcheck) checks them at run time, see LBC_SANITIZER_TESTS in cmake/Quality.cmake.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-*,
  performance-*,
  readability-avoid-const-params-in-decls,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  readability-else-after-return,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-non-const-parameter,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-optin.performance.Padding,
  -misc-no-recursion,
  -readability-redundant-declaration,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  -misc-non-private-member-variables-in-classes,
  -performance-enum-size,
  -performance-inefficient-string-concatenation
WarningsAsErrors: '*'
HeaderFilterRegex: '/(src|include|tools)/'
CheckOptions:
  bugprone-narrowing-conversions.WarnOnFloatingPointNarrowingConversion: false
  bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion: false
  cppcoreguidelines-narrowing-conversions.WarnOnFloatingPointNarrowingConversion: false
  cppcoreguidelines-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion: false
  # same-width sign changes (`int i = threadIdx.x`) are the CUDA idiom; truncations (int64 -> int) stay errors
  bugprone-narrowing-conversions.WarnOnEquivalentBitWidth: false
  cppcoreguidelines-narrowing-conversions.WarnOnEquivalentBitWidth: false
  # CERT ERR33-C (unchecked results: fopen, fclose, fwrite, snprintf truncation, strtol, ...) minus the console
  # output functions (fprintf / fflush / fputs to stdout or stderr: logging)
  cert-err33-c.CheckedFunctions: '^::aligned_alloc;^::asctime_s;^::at_quick_exit;^::atexit;^::bsearch;^::bsearch_s;^::btowc;^::c16rtomb;^::c32rtomb;^::calloc;^::clock;^::cnd_broadcast;^::cnd_init;^::cnd_signal;^::cnd_timedwait;^::cnd_wait;^::ctime_s;^::fclose;^::fgetc;^::fgetpos;^::fgets;^::fgetwc;^::fopen;^::fopen_s;^::fprintf_s;^::fread;^::freopen;^::freopen_s;^::fscanf;^::fscanf_s;^::fseek;^::fsetpos;^::ftell;^::fwprintf_s;^::fwrite;^::fwscanf;^::fwscanf_s;^::getc;^::getchar;^::getenv;^::getenv_s;^::gets_s;^::getwc;^::getwchar;^::gmtime;^::gmtime_s;^::localtime;^::localtime_s;^::malloc;^::mbrtoc16;^::mbrtoc32;^::mbsrtowcs;^::mbsrtowcs_s;^::mbstowcs;^::mbstowcs_s;^::memchr;^::mktime;^::mtx_init;^::mtx_lock;^::mtx_timedlock;^::mtx_trylock;^::mtx_unlock;^::printf_s;^::raise;^::realloc;^::remove;^::rename;^::scanf;^::scanf_s;^::setlocale;^::setvbuf;^::signal;^::snprintf;^::snprintf_s;^::sprintf;^::sprintf_s;^::sscanf;^::sscanf_s;^::strchr;^::strerror_s;^::strftime;^::strpbrk;^::strrchr;^::strstr;^::strtod;^::strtof;^::strtoimax;^::strtok;^::strtok_s;^::strtol;^::strtold;^::strtoll;^::strtoul;^::strtoull;^::strtoumax;^::strxfrm;^::swprintf;^::swprintf_s;^::swscanf;^::swscanf_s;^::thrd_create;^::thrd_detach;^::thrd_join;^::thrd_sleep;^::time;^::timespec_get;^::tmpfile;^::tmpfile_s;^::tmpnam;^::tmpnam_s;^::tss_create;^::tss_get;^::tss_set;^::ungetc;^::ungetwc;^::vfprintf_s;^::vfscanf;^::vfscanf_s;^::vfwprintf;^::vfwprintf_s;^::vfwscanf;^::vfwscanf_s;^::vprintf_s;^::vscanf;^::vscanf_s;^::vsnprintf;^::vsnprintf_s;^::vsprintf;^::vsprintf_s;^::vsscanf;^::vsscanf_s;^::vswprintf;^::vswprintf_s;^::vswscanf;^::vswscanf_s;^::vwprintf_s;^::vwscanf;^::vwscanf_s;^::wcrtomb;^::wcschr;^::wcsftime;^::wcspbrk;^::wcsrchr;^::wcsrtombs;^::wcsrtombs_s;^::wcsstr;^::wcstod;^::wcstof;^::wcstoimax;^::wcstok;^::wcstok_s;^::wcstol;^::wcstold;^::wcstoll;^::wcstombs;^::wcstombs_s;^::wcstoul;^::wcstoull;^::wcstoumax;^::wcsxfrm;^::wctob;^::wctrans;^::wctype;^::wmemchr;^::wprintf_s;^::wscanf;^::wscanf_s'
  # every CUDA / cuBLAS status must be used (wrap the call in LBC_CUDA / LBC_CUBLAS)
  bugprone-unused-return-value.CheckedReturnTypes: '::cudaError;::cudaError_t;::cublasStatus_t;::std::error_code;::std::errc'
  bugprone-unused-return-value.AllowCastToVoid: true
  cert-err33-c.AllowCastToVoid: true
